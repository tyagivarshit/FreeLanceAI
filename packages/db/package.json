{
  "name": "@freelanceos/db",
  "version": "0.1.0",
  "private": true,
  "description": "Database workspace shell establishing boundaries and architecture guidelines for FreelanceOS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=../../.env.test --test dist/repository/*.test.js",
    "test:unit": "node --env-file=../../.env.test --test dist/repository/*.test.js",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true });\""
  },
  "dependencies": {
    "@freelanceos/config": "*",
    "@freelanceos/core": "*",
    "drizzle-orm": "0.32.1",
    "pg": "8.12.0"
  },
  "devDependencies": {
    "@freelanceos/ts-config": "*",
    "drizzle-kit": "0.23.0",
    "@types/pg": "8.11.6"
  }
}
