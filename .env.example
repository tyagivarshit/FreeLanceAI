# =====================================================================
# Database Configuration (Docker & Local Dev)
# =====================================================================
# Owner: PostgreSQL relational service
# Purpose: Configures root connection credentials and default schema db.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_local
POSTGRES_DB=freelanceos_dev

# Owner: Host machine database port map
# Purpose: Maps local host port to container database port. Configurable to prevent local 5432 conflicts.
POSTGRES_PORT=5432

# Owner: Drizzle ORM client & app modules
# Purpose: Dynamic PostgreSQL connection pool URI.
DATABASE_URL=postgresql://postgres:postgres_password_local@localhost:5432/freelanceos_dev

# =====================================================================
# Redis Configuration (Docker & Local Dev)
# =====================================================================
# Owner: Redis memory caching service
# Purpose: Configures authentication password protection on the redis container.
REDIS_PASSWORD=redis_password_local

# Owner: Host machine caching port map
# Purpose: Maps local host port to container cache port. Configurable to prevent local 6379 conflicts.
REDIS_PORT=6379

# Owner: Task workers & session modules
# Purpose: Dynamic Redis connection URI.
REDIS_URL=redis://:redis_password_local@localhost:6379/0

# =====================================================================
# Application Configuration (Local Dev)
# =====================================================================
# Owner: Fastify API application server
# Purpose: Specifies the port that the API server listens on.
API_PORT=4000

